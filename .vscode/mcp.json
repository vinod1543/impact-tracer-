{
	"servers": {
		"impactTracer": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["-m", "impact_tracer.mcp.server"],
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
				"LOG_LEVEL": "INFO"
			}
		}
	}
}
